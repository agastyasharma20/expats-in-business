# Copy to .env (npm run setup does this). Never commit .env. All values here are fake or local-only.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
DEMO_MODE=true
DEFAULT_LOCALE=en
# CI only: build without secrets. Never set this locally.
SKIP_ENV_VALIDATION=

# Database (Docker, local only). Host port 5433 so a local PostgreSQL on 5432 does not interfere.
DATABASE_URL=postgresql://eib:eib_local_only@localhost:5433/eib

# Auth (generate with: npx @better-auth/cli secret  or any 32+ char random string)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Mailpit, local)
SMTP_HOST=localhost
SMTP_PORT=1025
# A real provider needs a login (Brevo: port 587, SMTP_SECURE=false). Leave empty for Mailpit.
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# true = send no email at all (sandbox deploys with no mail server); sign in with the demo accounts instead
EMAIL_DISABLED=false
EMAIL_FROM="Expats in Business <no-reply@demo.eib.local>"
# Where /help contact messages go (Mailpit catches everything locally)
ADMIN_INBOX_EMAIL=admin@demo.eib.local

# AI: groq | gemini | openrouter | demo | anthropic   (demo = offline, no key needed)
# Number of trusted reverse proxies (e.g. 1 behind Vercel or nginx); 0 ignores X-Forwarded-For
TRUSTED_PROXY_HOPS=0

AI_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DAILY_FREE_QUOTA=10
# Model calls per day for the whole platform; after that the offline demo adapter answers
AI_GLOBAL_DAILY_BUDGET=500
# Minimum cosine similarity for a guide passage to be used (0-1)
AI_SIMILARITY_THRESHOLD=0.4
# Local embedding model cache (all-MiniLM-L6-v2, downloaded once by npm run embed)
MODEL_CACHE_DIR=.cache/models

# Stripe TEST mode only (keys start with sk_test_ / pk_test_). Leave empty to simulate checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature flags (true/false). Cut order if late: coffee roulette -> session pulse -> bubbles map.
FEATURE_COFFEE_ROULETTE=true
FEATURE_SESSION_PULSE=true
FEATURE_BUBBLES_MAP=true
FEATURE_PAID_TICKETS=true
