# Copy to .env (npm run setup does this). Never commit .env. All values here are fake or local-only.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
DEMO_MODE=true
DEFAULT_LOCALE=en

# Database (Docker, local only)
DATABASE_URL=postgresql://eib:eib_local_only@localhost:5432/eib

# Auth (generate with: npx @better-auth/cli secret  or any 32+ char random string)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Mailpit, local)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Expats in Business <no-reply@demo.eib.local>"

# AI: groq | gemini | openrouter | demo | anthropic   (demo = offline, no key needed)
AI_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
AI_DAILY_FREE_QUOTA=10

# Stripe TEST mode only (keys start with sk_test_ / pk_test_). Leave empty to simulate checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
